# Copy this file to .env locally and replace placeholders with your own values.
# Never commit .env or reuse any credentials previously published in git history.
DATABASE_URL=postgresql://USERNAME:PASSWORD@localhost:5432/Auction1
SESSION_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
SECRET_KEY=REPLACE_WITH_A_SEPARATE_RANDOM_JWT_SIGNING_SECRET
REDIS_URL=redis://localhost:6379/0

# SQLAdmin remains disabled unless explicitly enabled.
# For optional admin access, use a dedicated PBKDF2-SHA256 password hash.
# Generate the hash locally using passlib; NEVER commit the password or the hash.
ENABLE_SQLADMIN=false
# ADMIN_USERNAME=your-unique-admin-username
# ADMIN_PASSWORD_HASH=$pbkdf2-sha256$...
# Put the site behind HTTPS before enabling interactive admin access.
